{
  "name": "virtual-pet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:data": "vitest run src/lib/catalog-validation.test.ts src/lib/catalog-narration-validation.test.ts src/lib/catalogue-compiler.test.ts && node scripts/generate-canonical-catalogue.mjs --check",
    "validate:assets": "node scripts/validate-assets.mjs",
    "validate:product": "node scripts/validate-product.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.56.9",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "^4.1.11"
  }
}
