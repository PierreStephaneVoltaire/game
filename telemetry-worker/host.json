{
  "version": "2.0",
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  },
  "extensions": {
    "queues": {
      "maxDequeueCount": 6,
      "visibilityTimeout": "00:01:00",
      "maxPollingInterval": "00:01:00",
      "batchSize": 16,
      "newBatchThreshold": 8,
      "messageEncoding": "none"
    }
  },
  "logging": {
    "logLevel": {
      "default": "Warning",
      "Function": "Information",
      "azure": "Warning"
    },
    "applicationInsights": { "samplingSettings": { "isEnabled": true } }
  }
}
